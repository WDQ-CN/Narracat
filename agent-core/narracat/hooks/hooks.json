{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "chapter-writer",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-chapter-writer-output.sh"
          }
        ]
      },
      {
        "matcher": "memory-keeper",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-memory-keeper-receipt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-chapter-wordcount.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-brief-lint.sh"
          }
        ]
      }
    ]
  }
}
